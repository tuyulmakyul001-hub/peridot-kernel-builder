From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Schedhorizon 6.1 Port <kernel@peridot.local>
Date: Fri, 27 Nov 2026 16:32:00 +0700
Subject: [PATCH] sched/cpufreq: Port schedhorizon governor to Android 6.1 GKI

- Port effective_cpu_util() and cpu_util_cfs() calls to Linux 6.1 signatures
- Update Android vendor hook to 6.1 trace_android_vh_map_util_freq()
- Remove obsolete 5.15 trace_android_rvh_set_sugov_update() call
- Fix Clang -Wformat, pointer type, bounds, and memory management issues
- Keep KMI/KABI untouched (adds governor only, no core struct changes)
---
 drivers/cpufreq/Kconfig            |  11 +
 kernel/sched/Makefile              |   1 +
 kernel/sched/cpufreq_schedhorizon.c | 971 ++++++++++++++++++++
 3 files changed, 983 insertions(+)
 create mode 100644 kernel/sched/cpufreq_schedhorizon.c

diff --git a/drivers/cpufreq/Kconfig b/drivers/cpufreq/Kconfig
--- a/drivers/cpufreq/Kconfig
+++ b/drivers/cpufreq/Kconfig
@@ -207,6 +207,17 @@ config CPU_FREQ_GOV_SCHEDUTIL
 
 	  If in doubt, say N.
 
+config CPU_FREQ_GOV_SCHEDHORIZON
+	bool "'schedhorizon' cpufreq policy governor"
+	depends on CPU_FREQ && SMP
+	select CPU_FREQ_GOV_ATTR_SET
+	select IRQ_WORK
+	help
+	  This governor is based on schedutil with separate up/down rate limits
+	  and configurable efficient frequency steps and up delays.
+
+	  If in doubt, say N.
+
 comment "CPU frequency scaling drivers"
 
 config CPUFREQ_DT
diff --git a/kernel/sched/Makefile b/kernel/sched/Makefile
--- a/kernel/sched/Makefile
+++ b/kernel/sched/Makefile
@@ -32,4 +32,5 @@
 obj-y += core.o
 obj-y += fair.o
 obj-y += build_policy.o
+obj-$(CONFIG_CPU_FREQ_GOV_SCHEDHORIZON) += cpufreq_schedhorizon.o
 obj-y += build_utility.o
diff --git a/kernel/sched/cpufreq_schedhorizon.c b/kernel/sched/cpufreq_schedhorizon.c
new file mode 100644
index 0000000..1111111
--- /dev/null
+++ b/kernel/sched/cpufreq_schedhorizon.c
@@ -0,0 +1,971 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * CPUFreq governor based on scheduler-provided CPU utilization data
+ * with configurable efficient frequency steps and up-delay horizons.
+ *
+ * Based on cpufreq_schedutil.c:
+ * Copyright (C) 2016, Intel Corporation
+ * Author: Rafael J. Wysocki <rafael.j.wysocki@intel.com>
+ *
+ * Ported to Android 6.1 GKI (android14-6.1).
+ */
+
+#define pr_fmt(fmt) KBUILD_MODNAME ": " fmt
+
+#include <linux/cpufreq.h>
+#include <linux/irq_work.h>
+#include <linux/kobject.h>
+#include <linux/kthread.h>
+#include <linux/math64.h>
+#include <linux/slab.h>
+#include <linux/string.h>
+#include <uapi/linux/sched/types.h>
+
+#include "sched.h"
+
+#include <linux/sched/cpufreq.h>
+#include <trace/events/power.h>
+#include <trace/hooks/sched.h>
+
+static unsigned int default_efficient_freq[] = {0};
+static u64 default_up_delay[] = {0};
+
+struct shz_tunables {
+	struct gov_attr_set	attr_set;
+	unsigned int		up_rate_limit_us;
+	unsigned int		down_rate_limit_us;
+	unsigned int		*efficient_freq;
+	int			nefficient_freq;
+	u64			*up_delay;
+	int			nup_delay;
+	int			current_step;
+};
+
+struct shz_policy {
+	struct cpufreq_policy	*policy;
+
+	struct shz_tunables	*tunables;
+	struct list_head	tunables_hook;
+
+	raw_spinlock_t		update_lock;
+	u64			last_freq_update_time;
+	s64			min_rate_limit_ns;
+	s64			up_rate_delay_ns;
+	s64			down_rate_delay_ns;
+	unsigned int		next_freq;
+	unsigned int		cached_raw_freq;
+	u64			first_hp_request_time;
+
+	/* The next fields are only needed if fast switch cannot be used: */
+	struct irq_work		irq_work;
+	struct kthread_work	work;
+	struct mutex		work_lock;
+	struct kthread_worker	worker;
+	struct task_struct	*thread;
+	bool			work_in_progress;
+
+	bool			limits_changed;
+	bool			need_freq_update;
+};
+
+struct shz_cpu {
+	struct update_util_data	update_util;
+	struct shz_policy	*sg_policy;
+	unsigned int		cpu;
+
+	u64			last_update;
+
+	unsigned long		util;
+	unsigned long		bw_dl;
+	unsigned long		max;
+};
+
+static inline int match_nearest_efficient_step(unsigned int freq, int maxstep,
+					       unsigned int *freq_table)
+{
+	int i;
+
+	if (maxstep <= 0)
+		return 0;
+
+	for (i = 0; i < maxstep; i++) {
+		if (freq_table[i] >= freq)
+			break;
+	}
+
+	if (i >= maxstep)
+		return maxstep - 1;
+
+	return i;
+}
+
+static inline void do_freq_limit(struct shz_policy *sg_policy,
+				 unsigned int *freq, u64 time)
+{
+	struct shz_tunables *tunables = sg_policy->tunables;
+
+	if (!tunables->nefficient_freq || !tunables->efficient_freq[0])
+		return;
+
+	if (tunables->current_step >= tunables->nefficient_freq)
+		tunables->current_step = tunables->nefficient_freq - 1;
+
+	if (*freq > tunables->efficient_freq[tunables->current_step] &&
+	    !sg_policy->first_hp_request_time) {
+		/* First request */
+		*freq = tunables->efficient_freq[tunables->current_step];
+		sg_policy->first_hp_request_time = time;
+		return;
+	}
+
+	if (*freq < tunables->efficient_freq[tunables->current_step]) {
+		/* Under current efficient frequency: step down */
+		tunables->current_step = match_nearest_efficient_step(
+			*freq, tunables->nefficient_freq, tunables->efficient_freq);
+		sg_policy->first_hp_request_time = 0;
+		return;
+	}
+
+	if (sg_policy->first_hp_request_time &&
+	    tunables->current_step < tunables->nup_delay &&
+	    time < sg_policy->first_hp_request_time +
+		   tunables->up_delay[tunables->current_step]) {
+		/* Restrict until up_delay expires */
+		*freq = tunables->efficient_freq[tunables->current_step];
+		return;
+	}
+
+	if (tunables->current_step + 1 <= tunables->nefficient_freq - 1 &&
+	    tunables->current_step + 1 <= tunables->nup_delay - 1) {
+		/* Unlock next higher efficient frequency step */
+		tunables->current_step++;
+		sg_policy->first_hp_request_time = time;
+		if (*freq > tunables->efficient_freq[tunables->current_step])
+			*freq = tunables->efficient_freq[tunables->current_step];
+		return;
+	}
+}
+
+static DEFINE_PER_CPU(struct shz_cpu, shz_cpu);
+
+/************************ Governor internals ***********************/
+
+static bool shz_should_update_freq(struct shz_policy *sg_policy, u64 time)
+{
+	s64 delta_ns;
+
+	if (!cpufreq_this_cpu_can_update(sg_policy->policy))
+		return false;
+
+	if (unlikely(sg_policy->limits_changed)) {
+		sg_policy->limits_changed = false;
+		sg_policy->need_freq_update =
+			cpufreq_driver_test_flags(CPUFREQ_NEED_UPDATE_LIMITS);
+		return true;
+	}
+
+	delta_ns = time - sg_policy->last_freq_update_time;
+	return delta_ns >= sg_policy->min_rate_limit_ns;
+}
+
+static bool shz_up_down_rate_limit(struct shz_policy *sg_policy, u64 time,
+				   unsigned int next_freq)
+{
+	s64 delta_ns;
+
+	delta_ns = time - sg_policy->last_freq_update_time;
+
+	if (next_freq > sg_policy->next_freq &&
+	    delta_ns < sg_policy->up_rate_delay_ns)
+		return true;
+
+	if (next_freq < sg_policy->next_freq &&
+	    delta_ns < sg_policy->down_rate_delay_ns)
+		return true;
+
+	return false;
+}
+
+static bool shz_update_next_freq(struct shz_policy *sg_policy, u64 time,
+				 unsigned int next_freq)
+{
+	if (!sg_policy->need_freq_update && sg_policy->next_freq == next_freq)
+		return false;
+
+	if (shz_up_down_rate_limit(sg_policy, time, next_freq))
+		return false;
+
+	sg_policy->need_freq_update = false;
+	sg_policy->next_freq = next_freq;
+	sg_policy->last_freq_update_time = time;
+
+	return true;
+}
+
+static void shz_deferred_update(struct shz_policy *sg_policy)
+{
+	if (!sg_policy->work_in_progress) {
+		sg_policy->work_in_progress = true;
+		irq_work_queue(&sg_policy->irq_work);
+	}
+}
+
+static unsigned int shz_get_next_freq(struct shz_policy *sg_policy,
+				      unsigned long util, unsigned long max,
+				      u64 time)
+{
+	struct cpufreq_policy *policy = sg_policy->policy;
+	unsigned int freq = arch_scale_freq_invariant() ?
+				policy->cpuinfo.max_freq : policy->cur;
+	unsigned int idx, l_freq, h_freq;
+	unsigned long next_freq = 0;
+
+	util = map_util_perf(util);
+	trace_android_vh_map_util_freq(util, freq, max, &next_freq, policy,
+				       &sg_policy->need_freq_update);
+	if (next_freq)
+		freq = next_freq;
+	else
+		freq = map_util_freq(util, freq, max);
+
+	do_freq_limit(sg_policy, &freq, time);
+
+	if (freq == sg_policy->cached_raw_freq && !sg_policy->need_freq_update)
+		return sg_policy->next_freq;
+
+	sg_policy->cached_raw_freq = freq;
+	l_freq = cpufreq_driver_resolve_freq(policy, freq);
+	if (!policy->freq_table)
+		return l_freq;
+
+	idx = cpufreq_frequency_table_target(policy, freq, CPUFREQ_RELATION_H);
+	h_freq = policy->freq_table[idx].frequency;
+	h_freq = clamp(h_freq, policy->min, policy->max);
+	if (l_freq <= h_freq || l_freq == policy->min)
+		return l_freq;
+
+	/*
+	 * Use the frequency step below if the calculated frequency is <20%
+	 * higher than it.
+	 */
+	if (mult_frac(100, freq - h_freq, l_freq - h_freq) < 20)
+		return h_freq;
+
+	return l_freq;
+}
+
+static void shz_get_util(struct shz_cpu *sg_cpu)
+{
+	struct rq *rq = cpu_rq(sg_cpu->cpu);
+
+	sg_cpu->max = arch_scale_cpu_capacity(sg_cpu->cpu);
+	sg_cpu->bw_dl = cpu_bw_dl(rq);
+	sg_cpu->util = effective_cpu_util(sg_cpu->cpu,
+					  cpu_util_cfs(sg_cpu->cpu),
+					  FREQUENCY_UTIL, NULL);
+}
+
+/*
+ * Make shz_should_update_freq() ignore the rate limit when DL
+ * has increased the utilization.
+ */
+static inline void ignore_dl_rate_limit(struct shz_cpu *sg_cpu)
+{
+	if (cpu_bw_dl(cpu_rq(sg_cpu->cpu)) > sg_cpu->bw_dl)
+		sg_cpu->sg_policy->limits_changed = true;
+}
+
+static inline bool shz_update_single_common(struct shz_cpu *sg_cpu,
+					    u64 time, unsigned int flags)
+{
+	sg_cpu->last_update = time;
+
+	ignore_dl_rate_limit(sg_cpu);
+
+	if (!shz_should_update_freq(sg_cpu->sg_policy, time))
+		return false;
+
+	shz_get_util(sg_cpu);
+
+	return true;
+}
+
+static void shz_update_single_freq(struct update_util_data *hook, u64 time,
+				   unsigned int flags)
+{
+	struct shz_cpu *sg_cpu = container_of(hook, struct shz_cpu, update_util);
+	struct shz_policy *sg_policy = sg_cpu->sg_policy;
+	unsigned int next_f;
+
+	if (!shz_update_single_common(sg_cpu, time, flags))
+		return;
+
+	next_f = shz_get_next_freq(sg_policy, sg_cpu->util, sg_cpu->max, time);
+
+	if (!shz_update_next_freq(sg_policy, time, next_f))
+		return;
+
+	if (sg_policy->policy->fast_switch_enabled) {
+		cpufreq_driver_fast_switch(sg_policy->policy, next_f);
+	} else {
+		raw_spin_lock(&sg_policy->update_lock);
+		shz_deferred_update(sg_policy);
+		raw_spin_unlock(&sg_policy->update_lock);
+	}
+}
+
+static void shz_update_single_perf(struct update_util_data *hook, u64 time,
+				   unsigned int flags)
+{
+	struct shz_cpu *sg_cpu = container_of(hook, struct shz_cpu, update_util);
+
+	if (!arch_scale_freq_invariant()) {
+		shz_update_single_freq(hook, time, flags);
+		return;
+	}
+
+	if (!shz_update_single_common(sg_cpu, time, flags))
+		return;
+
+	cpufreq_driver_adjust_perf(sg_cpu->cpu, map_util_perf(sg_cpu->bw_dl),
+				   map_util_perf(sg_cpu->util), sg_cpu->max);
+
+	sg_cpu->sg_policy->last_freq_update_time = time;
+}
+
+static unsigned int shz_next_freq_shared(struct shz_cpu *sg_cpu, u64 time)
+{
+	struct shz_policy *sg_policy = sg_cpu->sg_policy;
+	struct cpufreq_policy *policy = sg_policy->policy;
+	unsigned long util = 0, max = 1;
+	unsigned int j;
+
+	for_each_cpu(j, policy->cpus) {
+		struct shz_cpu *j_sg_cpu = &per_cpu(shz_cpu, j);
+		unsigned long j_util, j_max;
+
+		shz_get_util(j_sg_cpu);
+		j_util = j_sg_cpu->util;
+		j_max = j_sg_cpu->max;
+
+		if (j_util * max > j_max * util) {
+			util = j_util;
+			max = j_max;
+		}
+	}
+
+	return shz_get_next_freq(sg_policy, util, max, time);
+}
+
+static void shz_update_shared(struct update_util_data *hook, u64 time,
+			      unsigned int flags)
+{
+	struct shz_cpu *sg_cpu = container_of(hook, struct shz_cpu, update_util);
+	struct shz_policy *sg_policy = sg_cpu->sg_policy;
+	unsigned int next_f;
+
+	raw_spin_lock(&sg_policy->update_lock);
+
+	sg_cpu->last_update = time;
+
+	ignore_dl_rate_limit(sg_cpu);
+
+	if (shz_should_update_freq(sg_policy, time)) {
+		next_f = shz_next_freq_shared(sg_cpu, time);
+
+		if (!shz_update_next_freq(sg_policy, time, next_f))
+			goto unlock;
+
+		if (sg_policy->policy->fast_switch_enabled)
+			cpufreq_driver_fast_switch(sg_policy->policy, next_f);
+		else
+			shz_deferred_update(sg_policy);
+	}
+unlock:
+	raw_spin_unlock(&sg_policy->update_lock);
+}
+
+static void shz_work(struct kthread_work *work)
+{
+	struct shz_policy *sg_policy = container_of(work, struct shz_policy, work);
+	unsigned int freq;
+	unsigned long flags;
+
+	raw_spin_lock_irqsave(&sg_policy->update_lock, flags);
+	freq = sg_policy->next_freq;
+	sg_policy->work_in_progress = false;
+	raw_spin_unlock_irqrestore(&sg_policy->update_lock, flags);
+
+	mutex_lock(&sg_policy->work_lock);
+	__cpufreq_driver_target(sg_policy->policy, freq, CPUFREQ_RELATION_L);
+	mutex_unlock(&sg_policy->work_lock);
+}
+
+static void shz_irq_work(struct irq_work *irq_work)
+{
+	struct shz_policy *sg_policy;
+
+	sg_policy = container_of(irq_work, struct shz_policy, irq_work);
+
+	kthread_queue_work(&sg_policy->worker, &sg_policy->work);
+}
+
+static unsigned int *resolve_data_freq(const char *buf, int *num_ret,
+				       size_t count)
+{
+	const char *cp;
+	unsigned int *output;
+	int num = 1, i;
+
+	cp = buf;
+	while ((cp = strpbrk(cp + 1, " ")))
+		num++;
+
+	output = kmalloc_array(num, sizeof(unsigned int), GFP_KERNEL);
+	if (!output)
+		return NULL;
+
+	cp = buf;
+	i = 0;
+	while (i < num && (size_t)(cp - buf) < count) {
+		if (sscanf(cp, "%u", &output[i++]) != 1)
+			goto err_kfree;
+
+		cp = strpbrk(cp, " ");
+		if (!cp)
+			break;
+		cp++;
+	}
+
+	if (i == 0)
+		goto err_kfree;
+
+	*num_ret = i;
+	return output;
+
+err_kfree:
+	kfree(output);
+	return NULL;
+}
+
+static u64 *resolve_data_delay(const char *buf, int *num_ret, size_t count)
+{
+	const char *cp;
+	u64 *output;
+	int num = 1, i;
+
+	cp = buf;
+	while ((cp = strpbrk(cp + 1, " ")))
+		num++;
+
+	output = kcalloc(num, sizeof(u64), GFP_KERNEL);
+	if (!output)
+		return NULL;
+
+	cp = buf;
+	i = 0;
+	while (i < num && (size_t)(cp - buf) < count) {
+		if (sscanf(cp, "%llu", &output[i]) == 1) {
+			output[i] = output[i] * NSEC_PER_MSEC;
+			i++;
+		} else {
+			goto err_kfree;
+		}
+		cp = strpbrk(cp, " ");
+		if (!cp)
+			break;
+		cp++;
+	}
+
+	if (i == 0)
+		goto err_kfree;
+
+	*num_ret = i;
+	return output;
+
+err_kfree:
+	kfree(output);
+	return NULL;
+}
+
+/************************** sysfs interface ************************/
+
+static struct shz_tunables *global_tunables;
+static DEFINE_MUTEX(global_tunables_lock);
+
+static inline struct shz_tunables *to_shz_tunables(struct gov_attr_set *attr_set)
+{
+	return container_of(attr_set, struct shz_tunables, attr_set);
+}
+
+static DEFINE_MUTEX(min_rate_lock);
+
+static void update_min_rate_limit_ns(struct shz_policy *sg_policy)
+{
+	mutex_lock(&min_rate_lock);
+	sg_policy->min_rate_limit_ns = min(sg_policy->up_rate_delay_ns,
+					   sg_policy->down_rate_delay_ns);
+	mutex_unlock(&min_rate_lock);
+}
+
+static ssize_t up_rate_limit_us_show(struct gov_attr_set *attr_set, char *buf)
+{
+	struct shz_tunables *tunables = to_shz_tunables(attr_set);
+
+	return sprintf(buf, "%u\n", tunables->up_rate_limit_us);
+}
+
+static ssize_t down_rate_limit_us_show(struct gov_attr_set *attr_set, char *buf)
+{
+	struct shz_tunables *tunables = to_shz_tunables(attr_set);
+
+	return sprintf(buf, "%u\n", tunables->down_rate_limit_us);
+}
+
+static ssize_t up_rate_limit_us_store(struct gov_attr_set *attr_set,
+				      const char *buf, size_t count)
+{
+	struct shz_tunables *tunables = to_shz_tunables(attr_set);
+	struct shz_policy *sg_policy;
+	unsigned int rate_limit_us;
+
+	if (kstrtouint(buf, 10, &rate_limit_us))
+		return -EINVAL;
+
+	tunables->up_rate_limit_us = rate_limit_us;
+
+	list_for_each_entry(sg_policy, &attr_set->policy_list, tunables_hook) {
+		sg_policy->up_rate_delay_ns = rate_limit_us * NSEC_PER_USEC;
+		update_min_rate_limit_ns(sg_policy);
+	}
+
+	return count;
+}
+
+static ssize_t down_rate_limit_us_store(struct gov_attr_set *attr_set,
+					const char *buf, size_t count)
+{
+	struct shz_tunables *tunables = to_shz_tunables(attr_set);
+	struct shz_policy *sg_policy;
+	unsigned int rate_limit_us;
+
+	if (kstrtouint(buf, 10, &rate_limit_us))
+		return -EINVAL;
+
+	tunables->down_rate_limit_us = rate_limit_us;
+
+	list_for_each_entry(sg_policy, &attr_set->policy_list, tunables_hook) {
+		sg_policy->down_rate_delay_ns = rate_limit_us * NSEC_PER_USEC;
+		update_min_rate_limit_ns(sg_policy);
+	}
+
+	return count;
+}
+
+static ssize_t efficient_freq_show(struct gov_attr_set *attr_set, char *buf)
+{
+	struct shz_tunables *tunables = to_shz_tunables(attr_set);
+	int i;
+	ssize_t ret = 0;
+
+	for (i = 0; i < tunables->nefficient_freq; i++)
+		ret += sprintf(buf + ret, "%u%s",
+			       tunables->efficient_freq[i], " ");
+
+	if (ret > 0)
+		buf[ret - 1] = '\n';
+
+	return ret;
+}
+
+static ssize_t up_delay_show(struct gov_attr_set *attr_set, char *buf)
+{
+	struct shz_tunables *tunables = to_shz_tunables(attr_set);
+	int i;
+	ssize_t ret = 0;
+
+	for (i = 0; i < tunables->nup_delay; i++)
+		ret += sprintf(buf + ret, "%llu%s",
+			       div_u64(tunables->up_delay[i], NSEC_PER_MSEC),
+			       " ");
+
+	if (ret > 0)
+		buf[ret - 1] = '\n';
+
+	return ret;
+}
+
+static ssize_t efficient_freq_store(struct gov_attr_set *attr_set,
+				    const char *buf, size_t count)
+{
+	struct shz_tunables *tunables = to_shz_tunables(attr_set);
+	int new_num;
+	unsigned int *new_efficient_freq, *old;
+
+	new_efficient_freq = resolve_data_freq(buf, &new_num, count);
+	if (!new_efficient_freq)
+		return -EINVAL;
+
+	old = tunables->efficient_freq;
+	tunables->efficient_freq = new_efficient_freq;
+	tunables->nefficient_freq = new_num;
+	tunables->current_step = 0;
+	if (old != default_efficient_freq)
+		kfree(old);
+
+	return count;
+}
+
+static ssize_t up_delay_store(struct gov_attr_set *attr_set,
+			      const char *buf, size_t count)
+{
+	struct shz_tunables *tunables = to_shz_tunables(attr_set);
+	int new_num;
+	u64 *new_up_delay, *old;
+
+	new_up_delay = resolve_data_delay(buf, &new_num, count);
+	if (!new_up_delay)
+		return -EINVAL;
+
+	old = tunables->up_delay;
+	tunables->up_delay = new_up_delay;
+	tunables->nup_delay = new_num;
+	tunables->current_step = 0;
+	if (old != default_up_delay)
+		kfree(old);
+
+	return count;
+}
+
+static struct governor_attr up_rate_limit_us = __ATTR_RW(up_rate_limit_us);
+static struct governor_attr down_rate_limit_us = __ATTR_RW(down_rate_limit_us);
+static struct governor_attr efficient_freq = __ATTR_RW(efficient_freq);
+static struct governor_attr up_delay = __ATTR_RW(up_delay);
+
+static struct attribute *shz_attrs[] = {
+	&up_rate_limit_us.attr,
+	&down_rate_limit_us.attr,
+	&efficient_freq.attr,
+	&up_delay.attr,
+	NULL
+};
+ATTRIBUTE_GROUPS(shz);
+
+static void shz_tunables_free(struct kobject *kobj)
+{
+	struct gov_attr_set *attr_set =
+		container_of(kobj, struct gov_attr_set, kobj);
+	struct shz_tunables *tunables = to_shz_tunables(attr_set);
+
+	if (tunables->efficient_freq &&
+	    tunables->efficient_freq != default_efficient_freq)
+		kfree(tunables->efficient_freq);
+	if (tunables->up_delay && tunables->up_delay != default_up_delay)
+		kfree(tunables->up_delay);
+
+	kfree(tunables);
+}
+
+static struct kobj_type shz_tunables_ktype = {
+	.default_groups = shz_groups,
+	.sysfs_ops = &governor_sysfs_ops,
+	.release = &shz_tunables_free,
+};
+
+/********************** cpufreq governor interface *********************/
+
+static struct cpufreq_governor schedhorizon_gov;
+
+static struct shz_policy *shz_policy_alloc(struct cpufreq_policy *policy)
+{
+	struct shz_policy *sg_policy;
+
+	sg_policy = kzalloc(sizeof(*sg_policy), GFP_KERNEL);
+	if (!sg_policy)
+		return NULL;
+
+	sg_policy->policy = policy;
+	raw_spin_lock_init(&sg_policy->update_lock);
+	return sg_policy;
+}
+
+static void shz_policy_free(struct shz_policy *sg_policy)
+{
+	kfree(sg_policy);
+}
+
+static int shz_kthread_create(struct shz_policy *sg_policy)
+{
+	struct task_struct *thread;
+	struct sched_attr attr = {
+		.size		= sizeof(struct sched_attr),
+		.sched_policy	= SCHED_DEADLINE,
+		.sched_flags	= SCHED_FLAG_SUGOV,
+		.sched_nice	= 0,
+		.sched_priority	= 0,
+		/*
+		 * Fake (unused) bandwidth; workaround to "fix"
+		 * priority inheritance.
+		 */
+		.sched_runtime	=  1000000,
+		.sched_deadline = 10000000,
+		.sched_period	= 10000000,
+	};
+	struct cpufreq_policy *policy = sg_policy->policy;
+	int ret;
+
+	/* kthread only required for slow path */
+	if (policy->fast_switch_enabled)
+		return 0;
+
+	kthread_init_work(&sg_policy->work, shz_work);
+	kthread_init_worker(&sg_policy->worker);
+	thread = kthread_create(kthread_worker_fn, &sg_policy->worker,
+				"shzgov:%d",
+				cpumask_first(policy->related_cpus));
+	if (IS_ERR(thread)) {
+		pr_err("failed to create shzgov thread: %ld\n", PTR_ERR(thread));
+		return PTR_ERR(thread);
+	}
+
+	ret = sched_setattr_nocheck(thread, &attr);
+	if (ret) {
+		kthread_stop(thread);
+		pr_warn("%s: failed to set SCHED_DEADLINE\n", __func__);
+		return ret;
+	}
+
+	sg_policy->thread = thread;
+	kthread_bind_mask(thread, policy->related_cpus);
+	init_irq_work(&sg_policy->irq_work, shz_irq_work);
+	mutex_init(&sg_policy->work_lock);
+
+	wake_up_process(thread);
+
+	return 0;
+}
+
+static void shz_kthread_stop(struct shz_policy *sg_policy)
+{
+	/* kthread only required for slow path */
+	if (sg_policy->policy->fast_switch_enabled)
+		return;
+
+	kthread_flush_worker(&sg_policy->worker);
+	kthread_stop(sg_policy->thread);
+	mutex_destroy(&sg_policy->work_lock);
+}
+
+static struct shz_tunables *shz_tunables_alloc(struct shz_policy *sg_policy)
+{
+	struct shz_tunables *tunables;
+
+	tunables = kzalloc(sizeof(*tunables), GFP_KERNEL);
+	if (tunables) {
+		gov_attr_set_init(&tunables->attr_set, &sg_policy->tunables_hook);
+		if (!have_governor_per_policy())
+			global_tunables = tunables;
+	}
+	return tunables;
+}
+
+static void shz_clear_global_tunables(void)
+{
+	if (!have_governor_per_policy())
+		global_tunables = NULL;
+}
+
+static int shz_init(struct cpufreq_policy *policy)
+{
+	struct shz_policy *sg_policy;
+	struct shz_tunables *tunables;
+	int ret = 0;
+
+	/* State should be equivalent to EXIT */
+	if (policy->governor_data)
+		return -EBUSY;
+
+	cpufreq_enable_fast_switch(policy);
+
+	sg_policy = shz_policy_alloc(policy);
+	if (!sg_policy) {
+		ret = -ENOMEM;
+		goto disable_fast_switch;
+	}
+
+	ret = shz_kthread_create(sg_policy);
+	if (ret)
+		goto free_sg_policy;
+
+	mutex_lock(&global_tunables_lock);
+
+	if (global_tunables) {
+		if (WARN_ON(have_governor_per_policy())) {
+			ret = -EINVAL;
+			goto stop_kthread;
+		}
+		policy->governor_data = sg_policy;
+		sg_policy->tunables = global_tunables;
+
+		gov_attr_set_get(&global_tunables->attr_set,
+				 &sg_policy->tunables_hook);
+		goto out;
+	}
+
+	tunables = shz_tunables_alloc(sg_policy);
+	if (!tunables) {
+		ret = -ENOMEM;
+		goto stop_kthread;
+	}
+
+	tunables->up_rate_limit_us = 500;
+	tunables->down_rate_limit_us = 1000;
+	tunables->efficient_freq = default_efficient_freq;
+	tunables->nefficient_freq = ARRAY_SIZE(default_efficient_freq);
+	tunables->up_delay = default_up_delay;
+	tunables->nup_delay = ARRAY_SIZE(default_up_delay);
+
+	policy->governor_data = sg_policy;
+	sg_policy->tunables = tunables;
+
+	ret = kobject_init_and_add(&tunables->attr_set.kobj, &shz_tunables_ktype,
+				   get_governor_parent_kobj(policy), "%s",
+				   schedhorizon_gov.name);
+	if (ret)
+		goto fail;
+
+out:
+	mutex_unlock(&global_tunables_lock);
+	return 0;
+
+fail:
+	kobject_put(&tunables->attr_set.kobj);
+	policy->governor_data = NULL;
+	shz_clear_global_tunables();
+
+stop_kthread:
+	shz_kthread_stop(sg_policy);
+	mutex_unlock(&global_tunables_lock);
+
+free_sg_policy:
+	shz_policy_free(sg_policy);
+
+disable_fast_switch:
+	cpufreq_disable_fast_switch(policy);
+
+	pr_err("initialization failed (error %d)\n", ret);
+	return ret;
+}
+
+static void shz_exit(struct cpufreq_policy *policy)
+{
+	struct shz_policy *sg_policy = policy->governor_data;
+	struct shz_tunables *tunables = sg_policy->tunables;
+	unsigned int count;
+
+	mutex_lock(&global_tunables_lock);
+
+	count = gov_attr_set_put(&tunables->attr_set, &sg_policy->tunables_hook);
+	policy->governor_data = NULL;
+	if (!count)
+		shz_clear_global_tunables();
+
+	mutex_unlock(&global_tunables_lock);
+
+	shz_kthread_stop(sg_policy);
+	shz_policy_free(sg_policy);
+	cpufreq_disable_fast_switch(policy);
+}
+
+static int shz_start(struct cpufreq_policy *policy)
+{
+	struct shz_policy *sg_policy = policy->governor_data;
+	void (*uu)(struct update_util_data *data, u64 time, unsigned int flags);
+	unsigned int cpu;
+
+	sg_policy->up_rate_delay_ns =
+		sg_policy->tunables->up_rate_limit_us * NSEC_PER_USEC;
+	sg_policy->down_rate_delay_ns =
+		sg_policy->tunables->down_rate_limit_us * NSEC_PER_USEC;
+	update_min_rate_limit_ns(sg_policy);
+	sg_policy->last_freq_update_time	= 0;
+	sg_policy->next_freq			= 0;
+	sg_policy->work_in_progress		= false;
+	sg_policy->limits_changed		= false;
+	sg_policy->cached_raw_freq		= 0;
+	sg_policy->first_hp_request_time	= 0;
+
+	sg_policy->need_freq_update =
+		cpufreq_driver_test_flags(CPUFREQ_NEED_UPDATE_LIMITS);
+
+	for_each_cpu(cpu, policy->cpus) {
+		struct shz_cpu *sg_cpu = &per_cpu(shz_cpu, cpu);
+
+		memset(sg_cpu, 0, sizeof(*sg_cpu));
+		sg_cpu->cpu		= cpu;
+		sg_cpu->sg_policy	= sg_policy;
+	}
+
+	if (policy_is_shared(policy))
+		uu = shz_update_shared;
+	else if (policy->fast_switch_enabled && cpufreq_driver_has_adjust_perf())
+		uu = shz_update_single_perf;
+	else
+		uu = shz_update_single_freq;
+
+	for_each_cpu(cpu, policy->cpus) {
+		struct shz_cpu *sg_cpu = &per_cpu(shz_cpu, cpu);
+
+		cpufreq_add_update_util_hook(cpu, &sg_cpu->update_util, uu);
+	}
+	return 0;
+}
+
+static void shz_stop(struct cpufreq_policy *policy)
+{
+	struct shz_policy *sg_policy = policy->governor_data;
+	unsigned int cpu;
+
+	for_each_cpu(cpu, policy->cpus)
+		cpufreq_remove_update_util_hook(cpu);
+
+	synchronize_rcu();
+
+	if (!policy->fast_switch_enabled) {
+		irq_work_sync(&sg_policy->irq_work);
+		kthread_cancel_work_sync(&sg_policy->work);
+	}
+}
+
+static void shz_limits(struct cpufreq_policy *policy)
+{
+	struct shz_policy *sg_policy = policy->governor_data;
+
+	if (!policy->fast_switch_enabled) {
+		mutex_lock(&sg_policy->work_lock);
+		cpufreq_policy_apply_limits(policy);
+		mutex_unlock(&sg_policy->work_lock);
+	}
+
+	sg_policy->limits_changed = true;
+}
+
+static struct cpufreq_governor schedhorizon_gov = {
+	.name			= "schedhorizon",
+	.owner			= THIS_MODULE,
+	.flags			= CPUFREQ_GOV_DYNAMIC_SWITCHING,
+	.init			= shz_init,
+	.exit			= shz_exit,
+	.start			= shz_start,
+	.stop			= shz_stop,
+	.limits			= shz_limits,
+};
+
+#ifdef CONFIG_CPU_FREQ_DEFAULT_GOV_SCHEDHORIZON
+struct cpufreq_governor *cpufreq_default_governor(void)
+{
+	return &schedhorizon_gov;
+}
+#endif
+
+cpufreq_governor_init(schedhorizon_gov);
